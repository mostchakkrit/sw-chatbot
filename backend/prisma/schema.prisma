generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String   @map("image_url")
  specs       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("products")
}

model KnowledgeBase {
  id        String                      @id @default(uuid())
  content   String
  embedding Unsupported("vector(384)")?
  category  String?
  createdBy String?                     @map("created_by")
  updatedAt DateTime                    @updatedAt @map("updated_at")

  @@map("knowledge_base")
}

model Admin {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String @map("password_hash")
  name         String

  resolvedEscalations Escalation[]

  @@map("admins")
}

model Conversation {
  id                 String   @id @default(uuid())
  customerIdentifier String   @map("customer_identifier")
  status             String   @default("bot_handling")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  messages    Message[]
  escalations Escalation[]

  @@map("conversations")
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String       @map("conversation_id")
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  sender           String
  content          String
  retrievedContext Json?        @map("retrieved_context")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("messages")
}

model Escalation {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  reason         String
  resolvedBy     String?      @map("resolved_by")
  resolvedByAdmin Admin?      @relation(fields: [resolvedBy], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("escalations")
}
