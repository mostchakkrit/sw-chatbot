{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "app/**",
      "components/**",
      "lib/**",
      "public/**",
      "package.json",
      "package-lock.json",
      "Dockerfile",
      "next.config.ts",
      "proxy.ts",
      "tsconfig.json",
      "postcss.config.mjs"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
