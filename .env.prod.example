# Copy to .env on the EC2 host (same directory as docker-compose.prod.yml)
# and fill in real values. This file is read by docker compose's ${VAR}
# interpolation — do not commit the filled-in .env.

POSTGRES_PASSWORD=change_me

GROQ_API_KEY=

JWT_SECRET=change_me_to_a_long_random_string

ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_me
ADMIN_SEED_NAME=Admin
